{
  "name": "opencode-setup",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "bun src/cli.ts",
    "test": "vitest run",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "check": "bun run lint && bun run fmt:check && bun run typecheck && bun run test"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1",
    "oc-agent-plugins": "0.2.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "lefthook": "2.1.17",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
